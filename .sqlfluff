[sqlfluff]
dialect = bigquery
# jinja templater lints without a warehouse connection; switch to the dbt
# templater locally once profiles.yml is set up if you want full compilation.
templater = jinja
max_line_length = 100
exclude_rules = ST06

[sqlfluff:templater:jinja]
apply_dbt_builtins = True

[sqlfluff:indentation]
tab_space_size = 2

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower
